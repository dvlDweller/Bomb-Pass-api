{
  "info": {
    "name": "Bomb Pass Week 11 Module 1 - Question Set CRUD",
    "description": "Postman collection for testing Question Set Full CRUD (Module 1, Step 4).\n\nSeeded accounts used:\n- host: school_id 2099-0001 (Host Account, HOST role)\n- otherHost: school_id 2099-0003 (Second Host, HOST role)\n- player: school_id 2099-1001 (Alice Player, PLAYER role)\n\nCollection variables:\n- baseUrl: http://localhost:3001/api/v1\n- host, otherHost, player: school_id values for X-Demo-User header\n- setId: captured from the create response, reused across subsequent cases",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_variable_scope": "collection"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api/v1", "type": "string" },
    { "key": "host", "value": "2099-0001", "type": "string" },
    { "key": "otherHost", "value": "2099-0003", "type": "string" },
    { "key": "player", "value": "2099-1001", "type": "string" },
    { "key": "setId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Create a question set successfully",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Demo-User", "value": "{{host}}", "description": "Authenticated as host (school_id 2099-0001)" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Week 11 Sample Set\",\n  \"description\": \"Test question set for Module 1\",\n  \"subject\": \"General Knowledge\",\n  \"grade_level\": \"10\"\n}"
        },
        "url": "{{baseUrl}}/question-sets"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response contains question_set object\", function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.question_set).to.be.an('object');",
              "  pm.expect(json.question_set.question_set_id).to.be.a('number');",
              "  pm.expect(json.question_set.title).to.eql('Week 11 Sample Set');",
              "});",
              "pm.collectionVariables.set(\"setId\", pm.response.json().question_set.question_set_id);",
              "console.log(\"Captured setId:\", pm.collectionVariables.get(\"setId\"));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Invalid request fields",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Demo-User", "value": "{{host}}", "description": "Authenticated as host" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": 12345\n}"
        },
        "url": "{{baseUrl}}/question-sets"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 400\", function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Error code is VALIDATION_FAILED\", function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.error.code).to.eql('VALIDATION_FAILED');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
