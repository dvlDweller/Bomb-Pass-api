    {
      "name": "1. Create a question set successfully",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () {\n  pm.response.to.have.status(201);\n});\npm.test(\"Response contains question_set object\", function () {\n  const json = pm.response.json();\n  pm.expect(json.question_set).to.be.an('object');\n  pm.expect(json.question_set.question_set_id).to.be.a('number');\n  pm.expect(json.question_set.title).to.eql('Week 11 Sample Set');\n});\npm.collectionVariables.set(\"setId\", pm.response.json().question_set.question_set_id);\nconsole.log(\"Captured setId:\", pm.collectionVariables.get(\"setId\"));\n\npm.collectionVariables.set(\n  \"ownerUserId\",\n  pm.response.json().question_set.owner_user_id\n);"
            ]
          }
        }
      ],
