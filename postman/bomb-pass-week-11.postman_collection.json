    {
      "name": "1. Create a question set successfully",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () {\n  pm.response.to.have.status(201);\n});\n\nconst json = pm.response.json();\n\npm.test(\"Response contains the created question set\", function () {\n  pm.expect(json.question_set).to.be.an(\"object\");\n  pm.expect(json.question_set.question_set_id).to.be.a(\"number\");\n  pm.expect(json.question_set.title).to.eql(\"Week 11 Sample Set\");\n});\n\npm.collectionVariables.set(\n  \"setId\",\n  json.question_set.question_set_id\n);\n\npm.collectionVariables.set(\n  \"ownerUserId\",\n  json.question_set.owner_user_id\n);"
            ]
          }
        }
      ],
