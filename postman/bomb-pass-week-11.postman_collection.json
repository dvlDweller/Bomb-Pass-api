              "pm.test(\"Status is 200\", function () {\n  pm.response.to.have.status(200);\n});\npm.test(\"Title was updated\", function () {\n  const json = pm.response.json();\n  pm.expect(json.question_set.title).to.eql('Updated Sample Set');\n});\n\npm.test(\"PATCH cannot change question-set ownership\", function () {\n  const json = pm.response.json();\n  const originalOwnerId = Number(\n    pm.collectionVariables.get(\"ownerUserId\")\n  );\n\n  pm.expect(json.question_set.owner_user_id).to.eql(originalOwnerId);\n});"
            ]
